---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Jordan Hilario"
  description="This page doesn't exist. Browse fingerstyle guitar covers and tabs by Jordan Hilario."
>
  <section class="page-header">
    <div class="container">
      <p class="page-label">404</p>
      <h1>Page Not Found</h1>
      <p class="page-description">
        This page doesn't exist or has moved. Try one of these instead.
      </p>
      <div class="not-found-actions">
        <a href="/fingerstyle-videos/" class="btn btn-primary">Browse Guitar Covers</a>
        <a href="/" class="btn btn-outline">Back to Home</a>
      </div>
    </div>
  </section>

  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-bg-dark);
    color: var(--color-text-light);
    padding: 6rem 0;
  }

  .page-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .page-header h1 {
    margin-bottom: 1rem;
  }

  .page-description {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 550px;
    margin-bottom: 2rem;
  }

  .not-found-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .not-found-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
